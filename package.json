{
  "name": "k2-se-browser-slicer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "concurrently -k -n api,web -c cyan,green \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p tsconfig.server.json",
    "build:site": "pnpm build && node scripts/prepare-sites-build.mjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cors": "2.8.5",
    "express": "5.2.1",
    "fflate": "0.8.2",
    "lucide-react": "0.561.0",
    "multer": "2.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.181.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
